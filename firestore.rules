rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function onlyAllowedUserFieldsChanged() {
      return request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "firstName",
            "lastName",
            "phone",
            "city",
            "district",
            "neighborhood",
            "address",
            "about",
            "experience",
            "professions",
            "profilePhoto",
            "activeMode",
            "linkedCustomerUid",
            "linkedCraftsmanUid",
            "linkedCustomerEmail",
            "linkedCraftsmanEmail",
            "blockedUsers",
            "isOnline",
            "lastSeen",
            "fcmToken"
          ]);
    }

    // ================= USERS =================

    match /users/{userId} {

      allow read: if signedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
          && onlyAllowedUserFieldsChanged();
      allow delete: if false;

      match /favorites/{favoriteUserId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow update: if false;
      }

      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // ================= JOBS =================

    match /jobs/{jobId} {

      allow read: if signedIn();

      allow create: if signedIn();

      allow update: if signedIn() &&
          resource.data.userId == request.auth.uid;

      allow delete: if signedIn() &&
          resource.data.userId == request.auth.uid;
    }

    // ================= OFFERS =================

    match /offers/{offerId} {

      allow read: if signedIn();

      allow create: if signedIn();

      allow update: if signedIn();

      allow delete: if false;
    }

    // ================= CHATS =================

    match /chats/{chatId} {

      allow read: if signedIn() &&
          request.auth.uid in resource.data.users;

      allow create: if signedIn();

      allow update: if signedIn() &&
          request.auth.uid in resource.data.users;

      allow delete: if signedIn();

      match /messages/{messageId} {

        allow read: if signedIn() &&
            request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.users;

        allow create: if signedIn();

        allow update: if signedIn();

        allow delete: if signedIn();
      }
    }

    // ================= NOTIFICATIONS =================

    match /notifications/{notificationId} {

      allow read: if signedIn() &&
          resource.data.userId == request.auth.uid;

      allow create: if false;

      allow update: if false;

      allow delete: if false;
    }

    // ================= WALLET =================

    match /wallet_transactions/{transactionId} {

      allow read: if signedIn() &&
          resource.data.uid == request.auth.uid;

      allow create: if false;

      allow update: if false;

      allow delete: if false;
    }

    // ================= WITHDRAW =================

    match /withdraw_requests/{requestId} {

      allow read: if signedIn() &&
          resource.data.uid == request.auth.uid;

      allow create: if signedIn();

      allow update: if false;

      allow delete: if false;
    }

    // ================= REVIEWS =================

    match /reviews/{reviewId} {

      allow read: if signedIn();

      allow create: if signedIn();

      allow update: if false;

      allow delete: if false;
    }

    // ================= SUPPORT =================

    match /support_requests/{requestId} {

      allow read: if signedIn() &&
          resource.data.uid == request.auth.uid;

      allow create: if signedIn() &&
          request.resource.data.uid == request.auth.uid;

      allow update: if false;

      allow delete: if false;
    }

    // ================= SETTINGS =================

    match /user_settings/{userId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId);

      allow update: if isOwner(userId);

      allow delete: if false;
    }

    // ================= EMAIL =================

    match /email_verifications/{docId} {

      allow read, write: if false;
    }
  }
}