rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSafeNewUser(userId) {
      return isOwner(userId) &&
          request.resource.data.uid == userId &&
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.accountType in ["customer", "craftsman"] &&
          request.resource.data.activeMode == request.resource.data.accountType &&
          request.resource.data.customerProfile ==
              (request.resource.data.accountType == "customer") &&
          request.resource.data.craftsmanProfile ==
              (request.resource.data.accountType == "craftsman") &&
          request.resource.data.rating == 5 &&
          request.resource.data.completedJobs == 0 &&
          request.resource.data.tokens == 0 &&
          request.resource.data.isFrozen == false &&
          request.resource.data.isDeleting == false;
    }

    function onlyAllowedUserFieldsChanged() {
      return request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "firstName",
            "lastName",
            "phone",
            "city",
            "district",
            "neighborhood",
            "address",
            "about",
            "experience",
            "professions",
            "profilePhoto",
            "activeMode",
            "linkedCustomerUid",
            "linkedCraftsmanUid",
            "linkedCustomerEmail",
            "linkedCraftsmanEmail",
            "blockedUsers",
            "isOnline",
            "lastSeen",
            "fcmToken"
          ]);
    }

    // ================= USERS =================

    match /users/{userId} {

      allow read: if signedIn();
      allow create: if isSafeNewUser(userId);
      allow update: if isOwner(userId)
          && onlyAllowedUserFieldsChanged();
      allow delete: if false;

      match /favorites/{favoriteUserId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow update: if false;
      }

      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // ================= JOBS =================

    match /jobs/{jobId} {

      allow read: if signedIn();

      allow create: if signedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.id == jobId &&
          request.resource.data.status == "active";

      allow update: if signedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if signedIn() &&
          resource.data.userId == request.auth.uid;
    }

    // ================= OFFERS =================

    match /offers/{offerId} {

      allow read: if signedIn();

      allow create: if false;

      allow update: if signedIn() &&
          resource.data.customerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["isSeenByCustomer"]);

      allow delete: if false;
    }

    // ================= CHATS =================

    match /chats/{chatId} {

      allow read: if signedIn() &&
          request.auth.uid in resource.data.users;

      allow create: if false;

      allow update: if signedIn() &&
          request.auth.uid in resource.data.users &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["typing", "unreadCount"]);

      allow delete: if false;

      match /messages/{messageId} {

        allow read: if signedIn() &&
            request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.users;

        allow create: if false;

        allow update: if signedIn() &&
            resource.data.receiverId == request.auth.uid &&
            request.resource.data.senderId == resource.data.senderId &&
            request.resource.data.receiverId == resource.data.receiverId &&
            request.resource.data.message == resource.data.message &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "deliveredAt", "seenAt"]) &&
            ((resource.data.status == "sent" &&
                request.resource.data.status == "delivered") ||
             (resource.data.status == "delivered" &&
                request.resource.data.status == "seen"));

        allow delete: if false;
      }
    }

    // ================= NOTIFICATIONS =================

    match /notifications/{notificationId} {

      allow read: if signedIn() &&
          resource.data.userId == request.auth.uid;

      allow create: if false;

      allow update: if signedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["isRead"]);

      allow delete: if false;
    }

    // ================= WALLET =================

    match /wallet_transactions/{transactionId} {

      allow read: if signedIn() &&
          resource.data.uid == request.auth.uid;

      allow create: if false;

      allow update: if false;

      allow delete: if false;
    }

    // ================= WITHDRAW =================

    match /withdraw_requests/{requestId} {

      allow read: if signedIn() &&
          resource.data.uid == request.auth.uid;

      allow create: if signedIn() &&
          request.resource.data.uid == request.auth.uid;

      allow update: if false;

      allow delete: if false;
    }

    // ================= REVIEWS =================

    match /reviews/{reviewId} {

      allow read: if signedIn();

      allow create: if false;

      allow update: if false;

      allow delete: if false;
    }

    // ================= SUPPORT =================

    match /support_requests/{requestId} {

      allow read: if signedIn() &&
          resource.data.uid == request.auth.uid;

      allow create: if signedIn() &&
          request.resource.data.uid == request.auth.uid;

      allow update: if false;

      allow delete: if false;
    }

    // ================= SETTINGS =================

    match /user_settings/{userId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId);

      allow update: if isOwner(userId);

      allow delete: if false;
    }

    // ================= EMAIL =================

    match /email_verifications/{docId} {

      allow read, write: if false;
    }
  }
}
